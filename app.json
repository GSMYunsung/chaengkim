{
  "expo": {
    "name": "챙김",
    "slug": "chaengkim",
    "scheme": "chaengkim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.yuncastlee.chaengkim",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "백그라운드에서도 위치를 추적해 자리를 뜰 때 소지품 알림을 드립니다.",
        "NSLocationWhenInUseUsageDescription": "현재 위치를 파악해 체류 장소를 감지합니다.",
        "NSLocationAlwaysUsageDescription": "백그라운드에서도 위치를 추적해 자리를 뜰 때 소지품 알림을 드립니다.",
        "UIBackgroundModes": [
          "location"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yuncastlee.chaengkim",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/android-foreground.png",
        "backgroundColor": "#E7EEFE"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "백그라운드에서도 위치를 추적해 자리를 뜰 때 소지품 알림을 드립니다.",
          "locationAlwaysPermission": "백그라운드에서도 위치를 추적해 자리를 뜰 때 소지품 알림을 드립니다.",
          "locationWhenInUsePermission": "현재 위치를 파악해 체류 장소를 감지합니다.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3B82F6",
          "defaultChannel": "default"
        }
      ],
      "expo-task-manager",
      "@react-native-vector-icons/lucide",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/Pretendard-Regular.otf",
              "./assets/fonts/Pretendard-Medium.otf",
              "./assets/fonts/Pretendard-SemiBold.otf",
              "./assets/fonts/Pretendard-Bold.otf",
              "./assets/fonts/Pretendard-ExtraBold.otf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Pretendard-Regular.otf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Medium.otf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Pretendard-SemiBold.otf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Bold.otf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Pretendard-ExtraBold.otf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9e52d36c-a0b4-4c2c-a6ab-0b7a3119a3e8"
      }
    },
    "owner": "choi_yunsung",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9e52d36c-a0b4-4c2c-a6ab-0b7a3119a3e8"
    }
  }
}
